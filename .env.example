PORT=3000
# Choose a strong, private password (at least 12 characters). Never share this file.
ADMIN_PASSWORD=CHANGE-THIS-TO-A-STRONG-PRIVATE-PASSWORD
# Replace with a long random secret (at least 32 characters).
SESSION_SECRET=CHANGE-THIS-TO-A-LONG-RANDOM-SECRET-STRING
# Set NODE_ENV=production only when deployed behind HTTPS.
NODE_ENV=development
